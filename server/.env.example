MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/encartes
PORT=3001
CLIENT_URL=http://localhost:5173

# Production only (e.g. on Render): set to the server's own public URL so
# uploaded image links are generated correctly (https://<service>.onrender.com).
# Leave unset for local development - it's derived from the request instead.
# BASE_URL=https://encartes-server.onrender.com
